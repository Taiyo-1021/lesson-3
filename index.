<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Diphthongs — English Pronunciation Lesson</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Segoe UI',Arial,sans-serif;background:#0d1b2a;overflow:hidden;height:100vh;width:100vw}
#app{width:100vw;height:100vh;display:flex;flex-direction:column}
#progress{position:fixed;top:0;left:0;height:5px;background:linear-gradient(90deg,#ce93d8,#f48fb1);z-index:99;transition:width .3s ease;border-radius:0 3px 3px 0}
#slides{flex:1;position:relative;overflow:hidden;min-height:0}
.slide{position:absolute;inset:0;display:none;flex-direction:column}
.slide.active{display:flex}

/* NAV */
#nav{height:48px;background:#0a141f;display:flex;align-items:center;justify-content:center;gap:14px;flex-shrink:0;border-top:1px solid rgba(255,255,255,.08)}
#nav button{background:rgba(255,255,255,.1);border:none;color:#fff;font-size:13px;padding:6px 20px;border-radius:20px;cursor:pointer;transition:background .2s;font-family:inherit;letter-spacing:.3px}
#nav button:hover{background:rgba(255,255,255,.22)}
#nav button:disabled{opacity:.25;cursor:default}
#counter{color:rgba(255,255,255,.45);font-size:12px;min-width:60px;text-align:center}

/* SHARED */
.s-head{padding:12px 30px;font-size:16px;font-weight:700;color:#fff;display:flex;align-items:center;gap:10px;flex-shrink:0;letter-spacing:.2px}
.badge{background:rgba(255,255,255,.16);border-radius:20px;padding:3px 11px;font-size:11px;font-weight:600}
.s-body{flex:1;display:flex;padding:0 26px 12px;gap:22px;min-height:0;overflow:hidden}
.label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;opacity:.5;margin-bottom:6px}

/* ── TITLE ── */
.title-slide{background:linear-gradient(140deg,#0d001a 0%,#1a0030 55%,#0d001a 100%);align-items:center;justify-content:center;text-align:center}
.title-slide h1{font-size:clamp(46px,8.5vw,96px);font-weight:900;color:#fff;line-height:1;letter-spacing:-2px}
.title-slide h1 em{font-style:normal;background:linear-gradient(90deg,#ce93d8,#f48fb1);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.title-sub{font-size:clamp(14px,1.9vw,21px);color:rgba(255,255,255,.6);margin-top:12px}
.goal-box{margin-top:24px;background:rgba(206,147,216,.09);border:1.5px solid rgba(206,147,216,.28);border-radius:16px;padding:16px 28px;display:inline-block;text-align:left}
.goal-box p{color:#e1bee7;font-size:clamp(13px,1.5vw,17px);line-height:1.75}
.sym-strip{display:flex;gap:10px;margin-top:26px;justify-content:center;flex-wrap:wrap}
.sym-strip .sc{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:9px;padding:9px 15px;font-size:clamp(16px,2.6vw,28px);color:#ce93d8;font-weight:800}

/* ── OVERVIEW ── */
.ov-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:11px;width:100%;max-width:860px}
.ov-card{border-radius:13px;padding:13px 6px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:5px;box-shadow:0 2px 8px rgba(0,0,0,.09);transition:transform .18s}
.ov-card:hover{transform:translateY(-3px)}
.ov-sym{font-size:clamp(20px,3.2vw,40px);font-weight:900;line-height:1}
.ov-disp{font-size:clamp(9px,1vw,13px);font-weight:700;opacity:.7}
.ov-name{font-size:clamp(7px,.85vw,10px);opacity:.5;line-height:1.3;text-align:center}
.ov-word{font-size:clamp(9px,1vw,12px);font-style:italic;font-weight:600}

/* ── GLIDE ARROW ── */
.glide-box{background:#f5f0ff;border-radius:12px;padding:10px 16px;display:flex;align-items:center;gap:12px;border:1.5px solid #c084fc30}
.glide-v{font-size:clamp(20px,3vw,32px);font-weight:900;width:52px;text-align:center;border-radius:9px;padding:5px}
.glide-arr{font-size:22px;opacity:.4}
.glide-note{font-size:clamp(10px,1.15vw,13px);color:#555;line-height:1.55}

/* ── EXPLAIN ── */
.explain-slide{background:#fff;flex-direction:column}
.ex-left{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:11px;width:240px;flex-shrink:0;padding:4px 0}
.big-sym{font-size:clamp(52px,9vw,110px);font-weight:900;line-height:1;text-align:center}
.mouth-wrap{background:#f9f9f9;border-radius:13px;padding:7px;box-shadow:0 2px 12px rgba(0,0,0,.08)}
.lip-lbl{font-size:10px;color:#888;text-align:center;line-height:1.6}
.ex-right{flex:1;display:flex;flex-direction:column;justify-content:space-evenly;padding:4px 0;min-height:0;gap:7px}
.desc-card{border-radius:12px;padding:11px 15px}
.desc-card p{font-size:clamp(12px,1.4vw,15px);line-height:1.55;color:#1a2a3a;font-weight:500}
.howto{list-style:none;margin-top:5px;display:flex;flex-direction:column;gap:3px}
.howto li{font-size:clamp(11px,1.25vw,13px);padding-left:16px;position:relative;color:#2a3a4a;line-height:1.4}
.howto li::before{content:'→';position:absolute;left:0;opacity:.4;font-size:11px}
.tip-box{border-radius:12px;padding:11px 15px;display:flex;gap:9px;align-items:flex-start;background:#fdf5ff;border-left:4px solid #a855f7}
.tip-icon{font-size:18px;flex-shrink:0;margin-top:1px}
.tip-text{font-size:clamp(11px,1.3vw,14px);line-height:1.5;font-weight:500;color:#3a006a}
.ex-words{display:flex;gap:7px;flex-wrap:wrap}
.ex-chip{border-radius:10px;padding:8px 11px;display:flex;flex-direction:column;align-items:center;gap:2px;min-width:66px;box-shadow:0 2px 6px rgba(0,0,0,.07)}
.ex-chip .ew{font-size:clamp(13px,1.8vw,19px);font-weight:700}
.ex-chip .ei{font-size:clamp(9px,.95vw,11px);opacity:.55}
.ctx{border-radius:9px;padding:8px 13px;font-size:clamp(10px,1.1vw,12px);color:#555}

/* ── DRILL ── */
.drill-slide{background:#fdf5ff;flex-direction:column}
.dr-left{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;width:200px;flex-shrink:0}
.dr-sym{font-size:clamp(44px,7.5vw,90px);font-weight:900;line-height:1;text-align:center}
.dr-right{flex:1;display:flex;flex-direction:column;justify-content:space-between;padding:2px 0;min-height:0}
.repeat-instr{border-radius:12px;padding:11px 16px;margin-bottom:10px}
.repeat-instr .ri-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.repeat-instr .ri-flow{display:flex;align-items:center;gap:10px;font-size:clamp(13px,1.6vw,17px);font-weight:600;flex-wrap:wrap}
.ri-step{border-radius:8px;padding:5px 12px;white-space:nowrap}
.ri-arrow{font-size:18px;opacity:.35}
.word-rows{display:flex;flex-direction:column;gap:8px}
.wr{display:flex;align-items:center;gap:12px;background:#fff;border-radius:11px;padding:10px 16px;box-shadow:0 2px 6px rgba(0,0,0,.06)}
.wr-n{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;flex-shrink:0}
.wr-w{font-size:clamp(16px,2.5vw,28px);font-weight:700;flex:1}
.wr-p{font-size:clamp(10px,1.2vw,14px);opacity:.45}
.mp-box{border-radius:12px;padding:12px 16px}
.mp-box .label{margin-bottom:8px}
.mp-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.mp-item{text-align:center}
.mp-sym{font-size:clamp(11px,1.2vw,14px);font-weight:700;opacity:.6;margin-bottom:2px}
.mp-word{font-size:clamp(17px,2.7vw,30px);font-weight:800}
.mp-vs{font-size:16px;opacity:.25;font-weight:900}
.mp-note{font-size:clamp(11px,1.2vw,14px);color:#555;align-self:center;max-width:220px;line-height:1.5}

/* ── STUDENT DRILL ── */
.stdrill-slide{background:#fdf5ff;flex-direction:column}
.sd-instr{background:#fff;border-radius:13px;padding:13px 18px;border-left:5px solid #a855f7;flex-shrink:0}
.sd-instr h2{font-size:clamp(14px,1.7vw,19px);color:#3a006a;margin-bottom:7px}
.flow-steps{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px}
.fs{display:flex;align-items:flex-start;gap:7px;font-size:clamp(11px,1.25vw,14px);line-height:1.45;flex:1;min-width:160px}
.fs-n{background:#a855f7;color:#fff;border-radius:50%;width:21px;height:21px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;margin-top:1px}
.word-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:10px}
.wg{background:#fff;border-radius:12px;padding:13px 7px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.wg-w{font-size:clamp(18px,2.8vw,34px);font-weight:800}
.wg-sym{font-size:clamp(10px,1.1vw,13px);font-weight:600;margin-top:3px}

/* ── FEEDBACK ── */
.fb-slide{background:#fdf5ff;flex-direction:column}
.fb-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%}
.fb-card{background:#fff;border-radius:13px;padding:14px 18px;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.fb-card h3{font-size:clamp(12px,1.4vw,15px);font-weight:700;margin-bottom:10px}
.fb-list{list-style:none;display:flex;flex-direction:column;gap:6px}
.fb-list li{font-size:clamp(11px,1.25vw,14px);line-height:1.45;padding-left:16px;position:relative;color:#2a2a3a}
.fb-list li::before{content:'•';position:absolute;left:0;font-weight:700}
.fb-pair{display:inline-block;background:#f3e8ff;border-radius:6px;padding:2px 8px;font-weight:700;font-size:.95em;margin:0 2px}

/* ── QUIZ Q ── */
.quizq-slide{background:#fffbf2;flex-direction:column}
.q-grid{display:flex;flex-direction:column;gap:12px;width:100%}
.q-box{background:#fff;border-radius:13px;padding:15px 20px;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.q-num{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;opacity:.4;margin-bottom:5px}
.q-text{font-size:clamp(13px,1.6vw,18px);font-weight:600;margin-bottom:11px;line-height:1.4;color:#1a1a2e}
.q-opts{display:flex;gap:8px;flex-wrap:wrap}
.q-opt{border-radius:8px;padding:7px 16px;font-size:clamp(12px,1.5vw,16px);font-weight:700;border:2px solid #ddd;background:#f7f7f7;color:#333;cursor:default}
.think-banner{background:rgba(168,85,247,.1);border:1.5px solid rgba(168,85,247,.3);border-radius:12px;padding:12px 20px;text-align:center;font-size:clamp(13px,1.5vw,17px);color:#5b0fa8;font-weight:600;flex-shrink:0}

/* ── QUIZ A ── */
.quiza-slide{background:#f0fff4;flex-direction:column}
.qa-box{background:#fff;border-radius:13px;padding:15px 20px;box-shadow:0 2px 8px rgba(0,0,0,.07)}
.qa-opt{border-radius:8px;padding:7px 16px;font-size:clamp(12px,1.5vw,16px);font-weight:700;border:2px solid #ddd;background:#f7f7f7;color:#999;cursor:default}
.qa-opt.correct{background:#e8f5e9;border-color:#2e7d52;color:#1a5c35}
.qa-opt.correct::after{content:' ✓';font-weight:900}
.qa-hint{font-size:clamp(10px,1.15vw,13px);color:#2e7d52;margin-top:7px;font-weight:500;line-height:1.5}

/* ── SUMMARY ── */
.summary-slide{background:linear-gradient(140deg,#0d001a 0%,#1a0030 100%);flex-direction:column}
.sum-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:11px;padding:10px 26px;width:100%}
.sum-card{border-radius:13px;padding:13px 6px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:7px;box-shadow:0 3px 12px rgba(0,0,0,.22);transition:transform .18s}
.sum-card:hover{transform:translateY(-3px)}
.sc-sym{font-size:clamp(20px,3.2vw,44px);font-weight:900;color:#fff}
.sc-disp{font-size:clamp(9px,1vw,12px);color:rgba(255,255,255,.5);font-weight:600}
.sc-ws{font-size:clamp(8px,.9vw,11px);color:rgba(255,255,255,.38);font-style:italic;line-height:1.6}
.sum-foot{text-align:center;color:rgba(255,255,255,.6);font-size:clamp(12px,1.35vw,16px);padding:8px 26px 4px}
.sum-foot strong{color:#e1bee7}
.nxt-box{background:rgba(255,255,255,.06);border-radius:12px;padding:11px 22px;margin-top:10px;display:inline-block}
.nxt-box p{color:rgba(255,255,255,.5);font-size:clamp(11px,1.2vw,14px);line-height:1.6}
.nxt-box strong{color:#ce93d8}

/* ── FREE CONVERSATION ── */
.freeconv-slide{background:linear-gradient(140deg,#1a1200 0%,#2d2000 55%,#1a1200 100%);flex-direction:column}
.fc-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:0 36px 16px;text-align:center}
.fc-badge{background:rgba(255,200,50,.15);border:1.5px solid rgba(255,200,50,.4);border-radius:20px;padding:5px 16px;font-size:clamp(10px,1.1vw,13px);font-weight:700;color:#ffd740;letter-spacing:1.5px;text-transform:uppercase}
.fc-topic{font-size:clamp(26px,5vw,64px);font-weight:900;color:#fff;line-height:1.1;max-width:800px}
.fc-questions{display:flex;flex-direction:column;gap:9px;margin-top:4px;width:100%;max-width:600px}
.fc-q{background:rgba(255,255,255,.07);border-radius:12px;padding:12px 20px;font-size:clamp(13px,1.6vw,18px);color:rgba(255,255,255,.85);font-weight:500;text-align:left;border-left:4px solid #ffd740}
.fc-note{font-size:clamp(10px,1.1vw,13px);color:rgba(255,255,255,.35);margin-top:4px;line-height:1.6}
.fc-teacher{background:rgba(255,200,50,.08);border:1px solid rgba(255,200,50,.2);border-radius:12px;padding:10px 20px;font-size:clamp(10px,1.15vw,13px);color:rgba(255,200,50,.7);width:100%;max-width:600px;text-align:left;line-height:1.7}
.fc-teacher strong{color:#ffd740}
</style>
</head>
<body>
<div id="app">
  <div id="progress"></div>
  <div id="slides"></div>
  <nav id="nav">
    <button id="btn-prev" onclick="move(-1)">◀ Prev</button>
    <span id="counter"></span>
    <button id="btn-next" onclick="move(1)">Next ▶</button>
    <button onclick="toggleFS()">⛶ Fullscreen</button>
  </nav>
</div>
<script>
'use strict';

// ═══════════════════════════════════════════
//  DATA
// ═══════════════════════════════════════════
const PH = [
  {
    sym:'eɪ', disp:'/eɪ/', color:'#C0392B', light:'#FDEDEC', dark:'#7b1a10',
    name:'Diphthong — Face Vowel',
    desc:'Start with /e/ (mouth open, lips spread), then glide smoothly up toward /ɪ/ — the mouth closes as you speak.',
    howto:['Begin with /e/ — lips spread, jaw open about one finger-width','Glide your tongue upward and forward as you hold the sound','Let your mouth naturally close toward /ɪ/ at the end','The movement is smooth — not two separate sounds!'],
    tip:'Think of saying "A" as in the alphabet. "day", "say", "face" — feel your mouth glide from open to nearly closed.',
    approx:'Like Japanese "エイ" said quickly as one smooth sound',
    context:'Common spellings: <b>ay</b> (day, say), <b>ai</b> (rain, train), <b>a_e</b> (face, late), <b>ei</b> (eight)',
    glide:{from:'/e/',to:'/ɪ/',note:'Open → Close — lips spread throughout'},
    ex:[{w:'day',p:'/deɪ/'},{w:'face',p:'/feɪs/'},{w:'rain',p:'/reɪn/'},{w:'late',p:'/leɪt/'},{w:'eight',p:'/eɪt/'}],
    pair:{s:'/e/',w1:'late',w2:'let',lbl:'DIPHTHONG vs. SHORT'},
    mouth:{lipOpenness:.40,lipWidth:.70,tongueHeight:.55,tongueBackness:.25,rounded:false},
    lipd:'Start: Lips SPREAD, mouth open',tonged:'Glide: tongue rises toward front',
  },
  {
    sym:'aɪ', disp:'/aɪ/', color:'#1976D2', light:'#E3F2FD', dark:'#0d47a1',
    name:'Diphthong — Price Vowel',
    desc:'Start with a wide-open /a/ (jaw fully dropped), then glide up toward /ɪ/ — a big mouth movement!',
    howto:['Begin with mouth wide open — jaw drops all the way down','Keep lips neutral and unrounded at the start','Glide your tongue high and forward toward /ɪ/','The jaw closes significantly as you finish the sound'],
    tip:'This is the English "I" (as in the pronoun). Say your name with "I" — "I am..." — that\'s /aɪ/! A big, dramatic glide.',
    approx:'Like Japanese "アイ" said quickly as one smooth sound',
    context:'Common spellings: <b>i_e</b> (time, like), <b>igh</b> (night, light), <b>y</b> (my, fly), <b>ie</b> (tie, die)',
    glide:{from:'/a/',to:'/ɪ/',note:'Wide open → Close — big jaw movement'},
    ex:[{w:'my',p:'/maɪ/'},{w:'time',p:'/taɪm/'},{w:'night',p:'/naɪt/'},{w:'fly',p:'/flaɪ/'},{w:'like',p:'/laɪk/'}],
    pair:{s:'/ɪ/',w1:'bite',w2:'bit',lbl:'DIPHTHONG vs. SHORT'},
    mouth:{lipOpenness:.75,lipWidth:.56,tongueHeight:.10,tongueBackness:.32,rounded:false},
    lipd:'Start: Mouth WIDE OPEN, neutral',tonged:'Glide: tongue rises high + front',
  },
  {
    sym:'ɔɪ', disp:'/ɔɪ/', color:'#00838F', light:'#E0F7FA', dark:'#004d5c',
    name:'Diphthong — Choice Vowel',
    desc:'Start with rounded /ɔː/ lips (like "or"), then glide up to /ɪ/ while spreading the lips — round to spread!',
    howto:['Begin with lips rounded in an oval shape — like /ɔː/','Jaw is moderately open at the start','Glide your tongue upward and spread your lips as you finish','End with lips slightly spread, like a small smile'],
    tip:'The movement goes from ROUNDED lips to SPREAD lips. "boy", "toy", "coin" — feel the lips change shape! This is the "oi" in Japanese オイ, but smoother.',
    approx:'Like Japanese "オイ" said quickly as one smooth sound',
    context:'Common spellings: <b>oy</b> (boy, toy, joy), <b>oi</b> (coin, noise, voice)',
    glide:{from:'/ɔː/',to:'/ɪ/',note:'Rounded → Spread — lips change shape'},
    ex:[{w:'boy',p:'/bɔɪ/'},{w:'coin',p:'/kɔɪn/'},{w:'voice',p:'/vɔɪs/'},{w:'toy',p:'/tɔɪ/'},{w:'noise',p:'/nɔɪz/'}],
    pair:{s:'/ɔː/',w1:'boy',w2:'bore',lbl:'DIPHTHONG vs. LONG'},
    mouth:{lipOpenness:.50,lipWidth:.35,tongueHeight:.30,tongueBackness:.72,rounded:true},
    lipd:'Start: Lips ROUNDED (oval)',tonged:'Glide: lips spread, tongue rises',
  },
  {
    sym:'əʊ', disp:'/əʊ/', color:'#558B2F', light:'#F1F8E9', dark:'#2e5010',
    name:'Diphthong — Goat Vowel',
    desc:'Start with neutral /ə/ (schwa — relaxed centre), then round and close the lips toward /ʊ/ — a gentle glide.',
    howto:['Begin with completely relaxed mouth — like the schwa /ə/','Jaw is barely open, lips neutral','Gently round your lips and pull them slightly forward as you glide','End with lips lightly rounded, like a small circle'],
    tip:'British English "o" as in "go", "home", "no". Start relaxed, end rounded. American English says this differently — but in BrE it\'s always /əʊ/.',
    approx:'Like Japanese "オウ" said quickly, starting very relaxed',
    context:'Common spellings: <b>o</b> (go, so, no), <b>oa</b> (coat, road), <b>ow</b> (know, show), <b>o_e</b> (home, bone)',
    glide:{from:'/ə/',to:'/ʊ/',note:'Neutral → Rounded — gentle lip movement'},
    ex:[{w:'go',p:'/ɡəʊ/'},{w:'home',p:'/həʊm/'},{w:'coat',p:'/kəʊt/'},{w:'know',p:'/nəʊ/'},{w:'road',p:'/rəʊd/'}],
    pair:{s:'/ɒ/',w1:'coat',w2:'cot',lbl:'DIPHTHONG vs. SHORT'},
    mouth:{lipOpenness:.35,lipWidth:.50,tongueHeight:.45,tongueBackness:.50,rounded:false},
    lipd:'Start: Lips NEUTRAL (relaxed)',tonged:'Glide: lips round and close',
  },
  {
    sym:'aʊ', disp:'/aʊ/', color:'#E65100', light:'#FBE9E7', dark:'#7a2000',
    name:'Diphthong — Mouth Vowel',
    desc:'Start with wide-open /a/ (jaw fully dropped), then glide back and round the lips toward /ʊ/ — open to round!',
    howto:['Begin with mouth wide open — jaw drops fully, lips neutral','Glide your tongue backward and downward','Round and close your lips toward /ʊ/ as you finish','The jaw closes and lips round significantly'],
    tip:'The word "mouth" itself contains /aʊ/! "out", "now", "house" — feel the big jaw movement followed by the lip rounding. A dramatic sound!',
    approx:'Like Japanese "アウ" said quickly as one smooth sound',
    context:'Common spellings: <b>ou</b> (out, house, loud), <b>ow</b> (now, brown, cow)',
    glide:{from:'/a/',to:'/ʊ/',note:'Wide open + neutral → Rounded'},
